	"tokenColors": [
		{
			"scope": [
				"meta.embedded",
				"source.groovy.embedded"
			],
			"settings": {
				"foreground": "#0a0506"
			}
		},
		{
			"scope": [
				"strong",
				"markup.bold",
				"markup.heading",
				"keyword.control",
				"storage"
			],
			"settings": {
				"fontStyle": "bold"
