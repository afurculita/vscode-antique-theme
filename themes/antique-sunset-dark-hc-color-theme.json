	"tokenColors": [
		{
			"scope": [
				"meta.embedded",
				"source.groovy.embedded"
			],
			"settings": {
				"foreground": "#ffe0c8"
			}
		},
		{
			"scope": [
				"strong",
				"markup.bold",
				"markup.heading",
				"keyword.control",
				"storage"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"keyword.control",
				"keyword.control.flow",
				"keyword.control.conditional",
				"keyword.control.loop",
				"keyword.control.trycatch"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#c8a3e0"
			}
		},
		{
			"scope": [
				"support.type.primitive",
				"support.type.builtin"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#7ec5c5"
			}
		},
		{
			"scope": [
				"entity.name.type.interface",
				"entity.name.type.enum"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#7ec5c5"
			}
		},
		{
			"scope": "keyword.operator.new",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#eb9bbf"
			}
		},
		{
			"scope": [
				"emphasis",
				"markup.italic",
				"comment"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
