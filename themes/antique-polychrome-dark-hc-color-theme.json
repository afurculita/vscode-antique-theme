	"tokenColors": [
		{
			"scope": [
				"meta.embedded",
				"source.groovy.embedded"
			],
			"settings": {
				"foreground": "#e8e0cc"
			}
		},
		{
			"scope": [
				"strong",
				"markup.bold",
				"markup.heading",
				"keyword.control",
				"storage"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"keyword.control",
				"keyword.control.flow",
				"keyword.control.conditional",
				"keyword.control.loop",
				"keyword.control.trycatch"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#c8a3e0"
			}
		},
		{
			"scope": [
				"support.type.primitive",
				"support.type.builtin"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#7ec5c5"
			}
		},
		{
			"scope": [
				"entity.name.type.interface",
				"entity.name.type.enum"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#7ec5c5"
			}
		},
		{
			"scope": "keyword.operator.new",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#eb9bbf"
			}
		},
		{
			"scope": [
				"emphasis",
				"markup.italic",
				"comment"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline",
				"variable.argument.css",
				"variable.scss"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": "markup.strikethrough",
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": "markup.heading.1.markdown",
			"settings": {
				"fontStyle": "bold underline",
				"foreground": "#e8e0cc"
			}
		},
		{
			"scope": "markup.heading.2.markdown",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#e8e0cc"
			}
		},
		{
			"scope": "markup.heading.3.markdown",
			"settings": {
				"fontStyle": "bold italic",
				"foreground": "#e8e0cc"
			}
		},
		{
			"scope": "markup.heading.4.markdown",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#c0b8a0"
			}
		},
		{
			"scope": "markup.heading.5.markdown",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#a8a394"
			}
		},
		{
			"scope": "markup.heading.6.markdown",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#9a9688"
			}
		},
		{
			"scope": [
				"punctuation.definition.heading.markdown",
				"punctuation.definition.list.begin.markdown",
				"punctuation.definition.quote.begin.markdown"
			],
			"settings": {
				"foreground": "#a8a394"
			}
		},
		{
			"scope": "markup.quote",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#a8a394"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.inline.raw.string",
				"markup.raw.block"
			],
			"settings": {
				"foreground": "#e89050"
			}
		},
		{
			"scope": "markup.link",
			"settings": {
				"foreground": "#a58fef"
			}
		},
		{
			"scope": "markup.underline.link",
			"settings": {
				"fontStyle": "underline",
				"foreground": "#a58fef"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "#97b8e5"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#e89050"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "#e85e7d"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#d88ad8"
			}
		},
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"comment.block.documentation"
			],
			"settings": {
				"foreground": "#e85e7d"
			}
		},
		{
			"scope": [
				"storage.type.class.jsdoc",
				"keyword.other.documentation",
				"entity.name.tag.jsdoc"
			],
			"settings": {
				"fontStyle": "bold italic",
				"foreground": "#e85e7d"
			}
		},
		{
			"scope": [
				"punctuation.definition.string.begin",
				"punctuation.definition.string.end",
				"string",
				"string.interpolated",
				"string.other",
				"string.quoted",
				"string.quoted.double",
				"string.quoted.other",
				"string.quoted.single",
				"string.quoted.triple",
				"string.unquoted"
			],
			"settings": {
				"foreground": "#a58fef"
			}
		},
		{
			"scope": "string.regexp",
			"settings": {
				"foreground": "#e89050"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"variable.other.constant.property"
			],
			"settings": {
				"foreground": "#e89050"
			}
		},
		{
			"scope": [
				"meta.function-call entity.name.function",
				"entity.name.method",
				"meta.method-call entity.name.function"
			],
			"settings": {
				"foreground": "#e89050",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"support.function.builtin",
				"support.method.builtin"
			],
			"settings": {
				"foreground": "#e89050",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"meta.import string.quoted",
				"meta.import string",
				"meta.export string.quoted",
				"meta.export string",
				"string.quoted.docstring"
			],
			"settings": {
				"foreground": "#c8a3e0",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#7fd49c"
			}
