		{
			"scope": "constant.language",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#7fd49c"
			}
		},
		{
			"scope": [
				"variable.language",
				"variable.language.this",
				"variable.language.super"
			],
			"settings": {
				"fontStyle": "bold italic",
				"foreground": "#7fd49c"
			}
		},
		{
			"scope": [
				"variable.other.constant",
				"variable.other.enummember"
			],
