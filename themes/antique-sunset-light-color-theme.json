	"tokenColors": [
		{
			"scope": [
				"meta.embedded",
				"source.groovy.embedded"
			],
			"settings": {
				"foreground": "#2a1620"
			}
		},
		{
			"scope": [
				"strong",
				"markup.bold",
				"markup.heading",
				"keyword.control",
				"storage"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"keyword.control",
				"keyword.control.flow",
				"keyword.control.conditional",
				"keyword.control.loop",
				"keyword.control.trycatch"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#c8a3e0"
			}
		},
		{
			"scope": [
				"support.type.primitive",
				"support.type.builtin"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#7ec5c5"
			}
		},
		{
			"scope": [
				"entity.name.type.interface",
				"entity.name.type.enum"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#7ec5c5"
			}
		},
		{
			"scope": "keyword.operator.new",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#eb9bbf"
			}
		},
		{
			"scope": [
				"emphasis",
				"markup.italic",
				"comment"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline",
				"variable.argument.css",
				"variable.scss"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": "markup.strikethrough",
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": "markup.heading.1.markdown",
			"settings": {
				"fontStyle": "bold underline",
				"foreground": "#2a1620"
			}
		},
		{
			"scope": "markup.heading.2.markdown",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#2a1620"
			}
		},
		{
			"scope": "markup.heading.3.markdown",
			"settings": {
				"fontStyle": "bold italic",
				"foreground": "#2a1620"
			}
		},
		{
			"scope": "markup.heading.4.markdown",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#5a3a40"
			}
		},
		{
			"scope": "markup.heading.5.markdown",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#705055"
			}
		},
		{
			"scope": "markup.heading.6.markdown",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#9a9688"
			}
		},
		{
			"scope": [
				"punctuation.definition.heading.markdown",
				"punctuation.definition.list.begin.markdown",
				"punctuation.definition.quote.begin.markdown"
			],
			"settings": {
				"foreground": "#705055"
			}
		},
		{
			"scope": "markup.quote",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#705055"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.inline.raw.string",
				"markup.raw.block"
			],
			"settings": {
				"foreground": "#f18701"
			}
		},
		{
			"scope": "markup.link",
			"settings": {
				"foreground": "#a02835"
			}
		},
		{
			"scope": "markup.underline.link",
			"settings": {
				"fontStyle": "underline",
				"foreground": "#a02835"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "#db3a34"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#f18701"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "#a02030"
			}
		},
