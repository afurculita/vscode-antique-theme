	"tokenColors": [
		{
			"scope": [
				"strong",
				"markup.bold",
				"markup.heading",
				"keyword.control",
				"storage"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"keyword.control",
				"keyword.control.flow",
				"keyword.control.conditional",
				"keyword.control.loop",
				"keyword.control.trycatch"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"support.type.primitive",
				"support.type.builtin"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.type.interface",
				"entity.name.type.enum"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "keyword.operator.new",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"emphasis",
				"markup.italic",
				"comment"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline",
				"variable.argument.css",
				"variable.scss"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": "markup.strikethrough",
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": "markup.heading.1.markdown",
			"settings": {
				"fontStyle": "bold underline",
				"foreground": "#000"
			}
		},
		{
			"scope": "markup.heading.2.markdown",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#000"
			}
		},
		{
			"scope": "markup.heading.3.markdown",
			"settings": {
				"fontStyle": "bold italic",
				"foreground": "#000"
			}
		},
		{
			"scope": "markup.heading.4.markdown",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#2a2820"
			}
		},
		{
			"scope": "markup.heading.5.markdown",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#504e44"
			}
		},
		{
			"scope": "markup.heading.6.markdown",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#555045"
			}
		},
		{
			"scope": "markup.quote",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.inline.raw.string",
				"markup.raw.block"
			],
			"settings": {
				"foreground": "#7a3500"
			}
		},
		{
			"scope": "markup.link",
			"settings": {
				"foreground": "#7a3500"
			}
		},
		{
			"scope": "markup.underline.link",
			"settings": {
				"fontStyle": "underline",
				"foreground": "#7a3500"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "#1e4e9e"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#7a3500"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "#990e2d"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#800080"
			}
		},
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"comment.block.documentation"
			],
			"settings": {
				"foreground": "#990e2d"
			}
		},
		{
			"scope": [
				"storage.type.class.jsdoc",
				"keyword.other.documentation",
				"entity.name.tag.jsdoc"
			],
			"settings": {
				"fontStyle": "bold italic",
				"foreground": "#990e2d"
			}
		},
		{
			"scope": [
				"punctuation.definition.string.begin",
				"punctuation.definition.string.end",
				"string",
				"string.interpolated",
				"string.other",
				"string.quoted",
				"string.quoted.double",
				"string.quoted.other",
				"string.quoted.single",
				"string.quoted.triple",
				"string.unquoted"
			],
			"settings": {
				"foreground": "#7a3500"
			}
		},
		{
			"scope": "string.regexp",
			"settings": {
				"foreground": "#7a3500"
			}
		},
		{
			"scope": [
				"meta.function-call entity.name.function",
				"entity.name.method",
				"meta.method-call entity.name.function"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"support.function.builtin",
				"support.method.builtin"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"meta.import string.quoted",
				"meta.import string",
				"meta.export string.quoted",
				"meta.export string",
				"string.quoted.docstring"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "constant.language",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"variable.language",
				"variable.language.this",
				"variable.language.super"
			],
			"settings": {
				"fontStyle": "bold italic"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"support.type"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.namespace",
				"entity.name.type.namespace",
				"entity.name.type.module"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "entity.other.inherited-class",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"support.variable",
				"support.class.builtin"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"meta.function entity.name.function"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": "support.function",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"storage.modifier",
				"storage.modifier.async",
				"storage.modifier.export"
			],
			"settings": {
				"fontStyle": "bold italic"
			}
		},
		{
			"scope": [
				"keyword.control.directive",
				"meta.preprocessor"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": "storage.type.function.arrow",
			"settings": {
				"fontStyle": ""
			}
		},
		{
			"scope": [
				"meta.decorator",
				"punctuation.decorator",
				"variable.annotation",
				"storage.type.annotation"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"constant.other.color",
				"constant.other.rgb-value"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#a00010",
				"fontStyle": "italic bold"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"fontStyle": "strikethrough italic"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"parameter": {
			"fontStyle": "italic"
