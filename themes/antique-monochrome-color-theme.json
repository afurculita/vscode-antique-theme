		"function": {
			"fontStyle": "bold"
		},
		"method": {
			"fontStyle": "bold"
		},
		"function.defaultLibrary": {
			"fontStyle": "italic"
		},
		"class": {
			"fontStyle": "italic"
		},
		"class.defaultLibrary": {
			"fontStyle": "italic"
		},
		"interface": {
